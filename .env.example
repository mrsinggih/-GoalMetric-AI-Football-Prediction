# ==============================================================================
# GoalMetric AI - Environment Variables Reference (.env.example)
# IMPORTANT: DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# Browser/Frontend must NEVER access SUPABASE_SERVICE_ROLE_KEY or API secrets directly.
# ==============================================================================

# Node / Express Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Supabase Database & Auth (Backend Server-side only)
# Used exclusively in backend server (src/backend/data-access/supabaseClient.ts)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-public-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-to-client

# Football Data Provider APIs (Optional / Production ingestion)
# e.g., API-Football, Football-Data.org
FOOTBALL_DATA_API_KEY=your-football-data-api-key-placeholder
FOOTBALL_DATA_PROVIDER_URL=https://v3.football.api-sports.io

# External Python Statistical Engine Microservice (Optional)
# If running python-engine/main.py as a standalone service
PYTHON_ENGINE_ENABLED=false
PYTHON_ENGINE_URL=http://localhost:8000
PYTHON_ENGINE_TIMEOUT_MS=5000

# Stripe / Payment Gateway (Backend Server-side only)
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret
STRIPE_PRICE_ID_PRO=price_pro_placeholder
STRIPE_PRICE_ID_ELITE=price_elite_placeholder

# Google Gemini API (Server-side Qualitative Match Narrative & Tactical Summary)
GEMINI_API_KEY=your-gemini-api-key-placeholder

# Client-Side Public Environment Variables (Vite prefixed)
# Only public safe variables can start with VITE_
VITE_APP_NAME="GoalMetric AI"
VITE_ENABLE_DEMO_MODE=true
VITE_API_BASE_URL=/api/v1
